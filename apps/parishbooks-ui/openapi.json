                                                },
                                                "additionalProperties": true
                                            },
                                            "nullable": true
                                        },
                                        "error": {
                                            "type": "object",
                                            "example": { "redis": { "status": "down", "message": "Could not connect", "responseTime": 3005 } },
                                            "additionalProperties": {
                                                "type": "object",
                                                "required": ["status"],
                                                "properties": {
                                                    "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                                                    "responseTime": { "type": "number", "description": "Time the health indicator took to respond, in ms" }
                                                },
                                                "additionalProperties": true
                                            },
                                            "nullable": true
                                        },
                                        "details": {
                                            "type": "object",
                                            "example": {
                                                "database": { "status": "up", "responseTime": 12 },
                                                "redis": { "status": "down", "message": "Could not connect", "responseTime": 3005 }
                                            },
                                            "additionalProperties": {
                                                "type": "object",
                                                "required": ["status"],
                                                "properties": {
                                                    "status": { "type": "string", "enum": ["up", "degraded", "down"] },
                                                    "responseTime": { "type": "number", "description": "Time the health indicator took to respond, in ms" }
                                                },
                                                "additionalProperties": true
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "summary": "Liveness probe",
                "tags": ["health"]
            }
