{
  "name": "@parishbooks/parishbooks-svc-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@parishbooks/parishbooks-svc"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "@parishbooks/parishbooks-svc:build",
          "@parishbooks/parishbooks-svc:serve"
        ],
        "options": {
          "jestConfig": "apps/parishbooks-svc-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
