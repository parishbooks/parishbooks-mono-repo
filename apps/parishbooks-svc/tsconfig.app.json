{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node"],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "target": "es2021",
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "emitDeclarationOnly": false,
        "noEmit": true,
        "paths": {
            "@parishbooks/iam": ["../../packages/iam/src/index.ts"],
            "@parishbooks/iam/*": ["../../packages/iam/src/*"],
            "@parishbooks/communications": ["../../packages/communications/src/index.ts"],
            "@parishbooks/communications/*": ["../../packages/communications/src/*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": [
        "out-tsc",
        "dist",
        "vite.config.ts",
        "vite.config.mts",
        "vitest.config.ts",
        "vitest.config.mts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/*.test.js",
        "src/**/*.spec.js",
        "src/**/*.test.jsx",
        "src/**/*.spec.jsx",
        "eslint.config.js",
        "eslint.config.cjs",
        "eslint.config.mjs"
    ],
    "references": [
        {
            "path": "../../packages/iam"
        },
        {
            "path": "../../packages/communications/tsconfig.lib.json"
        }
    ]
}
