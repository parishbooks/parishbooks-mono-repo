{
  "name": "@parishbooks/design-system",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ui/*": {
      "types": "./src/ui/*.tsx",
      "import": "./src/ui/*",
      "default": "./src/ui/*"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "import": "./src/utils.ts",
      "default": "./src/utils.ts"
    },
    "./theme-provider": {
      "types": "./src/theme-provider.tsx",
      "import": "./src/theme-provider.tsx",
      "default": "./src/theme-provider.tsx"
    },
    "./mode-toggle": {
      "types": "./src/mode-toggle.tsx",
      "import": "./src/mode-toggle.tsx",
      "default": "./src/mode-toggle.tsx"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "import": "./src/hooks/*",
      "default": "./src/hooks/*"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": ["scope:shared", "type:ui"]
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "react-hook-form": "^7.89.0",
    "shadcn": "^4.20.1",
    "tw-animate-css": "^1.4.0"
  }
}
