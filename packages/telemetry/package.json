{
    "name": "@parishbooks/telemetry",
    "version": "0.0.1",
    "private": true,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "@parishbooks/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./instrumentation": {
            "@parishbooks/source": "./src/lib/instrumentation.ts",
            "types": "./dist/lib/instrumentation.d.ts",
            "import": "./dist/lib/instrumentation.js",
            "default": "./dist/lib/instrumentation.js"
        }
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@opentelemetry/auto-instrumentations-node": "^0.81.0",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
        "@opentelemetry/resources": "^2.12.0",
        "@opentelemetry/sdk-metrics": "^2.12.0",
        "@opentelemetry/sdk-node": "^0.223.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "tslib": "^2.3.0"
    }
}
