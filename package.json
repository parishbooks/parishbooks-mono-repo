{
    "name": "@parishbooks/source",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "dev": "nx run-many -t serve -p tag:type:app --parallel",
        "dev:svc": "bun nx run @parishbooks/parishbooks-svc:serve:development",
        "dev:web": "bun nx run @parishbooks/parishbooks-ui:serve",
        "generate": "bun tools/generate/index.ts",
        "reset-workspace": "bunx nx reset",
        "lint": "bun nx run-many -t lint",
        "lint:fix": "bun nx run-many -t lint --fix",
        "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
        "db:generate": "bun nx run @parishbooks/database:db-generate",
        "db:migrate": "bun nx run @parishbooks/database:db-migrate",
        "db:reset": "bun nx run @parishbooks/database:db-reset",
        "openapi:generate": "bun nx run @parishbooks/api-sdk:generate:openapi",
        "e2e:svc": "NX_DAEMON=false bun nx run @parishbooks/parishbooks-svc-e2e:e2e",
        "prepare": "husky",
        "lint-staged": "lint-staged"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,mjs,cjs}": [
            "eslint --fix --max-warnings=0 --no-warn-ignored",
            "prettier --write"
        ],
        "*.{json,md,css,yml,yaml}": [
            "prettier --write"
        ]
    },
    "private": true,
