// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Auth API (e2e) > POST /auth/refresh > issues a new access token when the refresh cookie is valid > refresh 200 1`] = `
{
  "success": true,
}
`;

exports[`Auth API (e2e) > POST /auth/refresh > issues a new access token when the refresh cookie is valid > refresh 200 set-cookie 1`] = `
[
  "pb_access_token=<redacted>",
]
`;

exports[`Auth API (e2e) > POST /auth/refresh > returns 401 when the refresh cookie is missing > refresh 401 1`] = `
{
  "code": "REFRESH_INVALID",
  "message": "Refresh token is invalid or expired.",
  "path": "/api/v1/auth/refresh",
  "statusCode": 401,
  "timestamp": "<timestamp>",
}
`;

exports[`Auth API (e2e) > POST /auth/sign-in > returns 401 for invalid credentials > sign-in 401 1`] = `
{
  "code": "INVALID_CREDENTIALS",
  "message": "Invalid email or password.",
  "path": "/api/v1/auth/sign-in",
  "statusCode": 401,
  "timestamp": "<timestamp>",
}
`;

exports[`Auth API (e2e) > POST /auth/sign-in > returns 403 when the email is not verified > sign-in 403 unverified 1`] = `
{
  "code": "EMAIL_NOT_VERIFIED",
  "message": "Email address is not verified",
  "path": "/api/v1/auth/sign-in",
  "redirectTo": "/verify-email?email=<email>",
  "statusCode": 403,
  "timestamp": "<timestamp>",
}
`;

exports[`Auth API (e2e) > POST /auth/sign-in > sets auth cookies and returns tokens for a verified user > sign-in 200 set-cookie 1`] = `
[
  "pb_access_token=<redacted>",
  "pb_refresh_token=<redacted>",
]
`;

exports[`Auth API (e2e) > POST /auth/sign-in > sets auth cookies and returns tokens for a verified user > sign-in 200 verified 1`] = `
{
  "accessToken": "<jwt>",
  "redirectTo": "/dashboard",
  "refreshToken": "<jwt>",
}
`;

exports[`Auth API (e2e) > POST /auth/sign-up > creates a new account > sign-up 201 1`] = `
{
  "redirectTo": "/verify-email?email=<email>",
  "tenantId": "<uuid>",
  "userId": "<uuid>",
}
`;

exports[`Auth API (e2e) > POST /auth/sign-up > returns 400 when the email is already registered > sign-up 400 duplicate 1`] = `
{
  "code": "USER_ALREADY_EXISTS",
  "message": "An account with this email already exists.",
  "path": "/api/v1/auth/sign-up",
  "statusCode": 400,
  "timestamp": "<timestamp>",
}
`;
